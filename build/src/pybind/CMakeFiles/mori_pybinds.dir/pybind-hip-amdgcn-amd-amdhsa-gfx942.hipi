#pragma clang diagnostic pop
    }

    constexpr gil_safe_call_once_and_store() = default;
                            ~gil_safe_call_once_and_store() = default;

private:
    alignas(T) char storage_[sizeof(T)] = {};
    std::once_flag once_flag_ = {};



    bool

        is_initialized_{false};



};

