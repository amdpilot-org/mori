    for (const auto i : c10::irange(this->values_.size())) {
      this->values_[i] = values[i];
    }
  }




               ExpandingArrayWithOptionalElem(T single_size)
      : ExpandingArray<D, std::optional<T>>(0) {
    for (const auto i : c10::irange(this->values_.size())) {
      this->values_[i] = single_size;
