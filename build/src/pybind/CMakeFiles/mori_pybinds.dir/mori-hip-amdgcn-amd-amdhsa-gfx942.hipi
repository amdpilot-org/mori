inline Tensor _smooth_l1_loss(
    const Tensor& input,
    const Tensor& target,
    double beta = 1.) {
  auto t = torch::abs(input - target);
  return torch::where(t < beta, 0.5 * torch::pow(t, 2) / beta, t - 0.5 * beta);
}


namespace detail {
inline Tensor smooth_l1_loss(
    const Tensor& input,
    const Tensor& target,
    SmoothL1LossFuncOptions::reduction_t reduction,
    std::optional<double> beta_opt = std::nullopt) {
  if (target.sizes() != input.sizes()) {
    ::c10::warn(::c10::Warning( ::c10::UserWarning(), {__func__, "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/loss.h", static_cast<uint32_t>(355)}, ::c10::str("Using a target size (", target.sizes(), ") that is different to the input size (", input.sizes(), "). ", "This will likely lead to incorrect results due to broadcasting. ", "Please ensure they have the same size."), false));;;







  }
  double beta = beta_opt.value_or(1.0);

  std::vector<Tensor> expanded_tensors =
      torch::broadcast_tensors({input, target});
  return torch::smooth_l1_loss(
      expanded_tensors[0],
      expanded_tensors[1],
      enumtype::reduction_get_enum(reduction),
      beta);
}
}
