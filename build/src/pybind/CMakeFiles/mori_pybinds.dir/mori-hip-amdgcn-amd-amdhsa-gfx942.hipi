enum class HeapType {
  Normal,
  Uncached
};

struct VMMChunkKey {
  uint32_t key;
  uintptr_t next_addr;

  VMMChunkKey() : key(0), next_addr(0) {}
  VMMChunkKey(uint32_t k, uintptr_t addr) : key(k), next_addr(addr) {}
};

struct SymmMemObj {
  void* localPtr{nullptr};
  uintptr_t* peerPtrs{nullptr};
  size_t size{0};

  uint32_t lkey{0};
  uint32_t* peerRkeys{nullptr};




  VMMChunkKey* vmmLkeyInfo{nullptr};
  VMMChunkKey* vmmRkeyInfo{nullptr};
  size_t vmmNumChunks{0};
  int worldSize{0};

  hipIpcMemHandle_t* ipcMemHandles{nullptr};


  anvil::SdmaQueueDeviceHandle** deviceHandles_d = nullptr;
  HSAuint64* signalPtrs = nullptr;
  uint32_t sdmaNumQueue = 8;
  HSAuint64* expectSignalsPtr = nullptr;

  __attribute__((device)) __attribute__((host)) RdmaMemoryRegion GetRdmaMemoryRegion(int pe) const {
    RdmaMemoryRegion mr;
    mr.addr = peerPtrs[pe];
    mr.lkey = lkey;
    mr.rkey = peerRkeys[pe];
    mr.length = size;
    return mr;
  }


  inline __attribute__((device)) __attribute__((host)) void* Get() const { return localPtr; }
  inline __attribute__((device)) __attribute__((host)) void* Get(int pe) const {
    return reinterpret_cast<void*>(peerPtrs[pe]);
  }

  template <typename T>
  inline __attribute__((device)) __attribute__((host)) T GetAs() const {
    return reinterpret_cast<T>(localPtr);
  }
  template <typename T>
  inline __attribute__((device)) __attribute__((host)) T GetAs(int pe) const {
    return reinterpret_cast<T>(peerPtrs[pe]);
  }
};

struct SymmMemObjPtr {
  SymmMemObj* cpu{nullptr};
  SymmMemObj* gpu{nullptr};

  bool IsValid() { return (cpu != nullptr) && (gpu != nullptr); }

  __attribute__((host)) SymmMemObj* operator->() { return cpu; }
  __attribute__((device)) SymmMemObj* operator->() { return gpu; }
  __attribute__((host)) const SymmMemObj* operator->() const { return cpu; }
  __attribute__((device)) const SymmMemObj* operator->() const { return gpu; }
};

