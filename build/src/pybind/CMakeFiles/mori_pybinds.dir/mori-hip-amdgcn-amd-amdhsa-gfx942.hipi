    if (pe_turn == pe) {
      do { if constexpr (0 == 1) { ShmemPutSizeImmNbiThreadKernelAddrImpl<core::ProviderType::BNXT>(dest, val, bytes, pe, qpId); } else if constexpr (1 == 1) { ShmemPutSizeImmNbiThreadKernelAddrImpl<core::ProviderType::PSD>(dest, val, bytes, pe, qpId); } else { ShmemPutSizeImmNbiThreadKernelAddrImpl<core::ProviderType::MLX5>(dest, val, bytes, pe, qpId); } } while (0);

