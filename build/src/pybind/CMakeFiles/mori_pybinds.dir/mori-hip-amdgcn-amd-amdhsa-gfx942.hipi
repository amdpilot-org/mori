        stddev(torch::tensor(stddev, torch::kFloat32)
                   .unsqueeze( 1)
                   .unsqueeze( 2)) {}

  torch::Tensor operator()(Tensor input) override {
    return input.sub(mean).div(stddev);
  }

  torch::Tensor mean, stddev;
};
