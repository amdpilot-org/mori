    ::c10::warn(::c10::Warning( ::c10::UserWarning(), {__func__, "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/vision.h", static_cast<uint32_t>(84)}, ::c10::str("Default grid_sample and affine_grid behavior has changed ", "to align_corners=False since 1.3.0. Please specify ", "align_corners=True if the old behavior is desired. ", "See the documentation of grid_sample for details."), false));;;




    align_corners = false;
  }

  return torch::grid_sampler(
      input, grid, mode_enum, padding_mode_enum, align_corners.value());
}
