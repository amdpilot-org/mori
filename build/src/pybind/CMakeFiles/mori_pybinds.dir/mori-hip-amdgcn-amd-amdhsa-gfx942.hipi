}

template <>
inline __attribute__((device)) int PollCqAndUpdateDbr<ProviderType::PSD>(CompletionQueueHandle& cq,
                                                            uint32_t* consIdx, uint32_t* lockVar) {
  AcquireLock(lockVar);

  int err = PollCq<ProviderType::PSD>(cq.cqAddr, cq.cqeNum, consIdx);
  if (err >= 0) {
    UpdateCqDbrRecord<ProviderType::PSD>(cq, *consIdx);
  }

  ReleaseLock(lockVar);
  return err;
}

