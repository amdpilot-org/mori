      if (!(false)) { ::c10::detail::torchCheckFail( __func__, "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/pooling.h", static_cast<uint32_t>(658), (::c10::detail::torchCheckMsgImpl( "Expected " "false" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "output_size should be a sequence containing ", kernel_size.size(), " or ", kernel_size.size() + 2, " elements, but it has a length of '", output_size_.size(), "'"))); };
# 659 "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/pooling.h" 3
    }
    for (const auto d : c10::irange(kernel_size.size())) {
      const auto min_size = default_size[d] - stride[d];
      const auto max_size = default_size[d] + stride[d];
      if (!(min_size <= output_size_[d] && output_size_[d] <= max_size)) {
        if (!(false)) { ::c10::detail::torchCheckFail( __func__, "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/pooling.h", static_cast<uint32_t>(674), (::c10::detail::torchCheckMsgImpl( "Expected " "false" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "invalid output_size ", output_size_, " (dim ", d, " must be between ", min_size, " and ", max_size, ")"))); };
