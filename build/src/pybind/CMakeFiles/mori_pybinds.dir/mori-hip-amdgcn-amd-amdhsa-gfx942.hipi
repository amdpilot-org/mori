__attribute__((host)) __attribute__((device)) inline constexpr HIP_vector_type<T, n> operator+(
    const HIP_vector_type<T, n>& x, const HIP_vector_type<T, n>& y) noexcept {
  return HIP_vector_type<T, n>{x} += y;
}
