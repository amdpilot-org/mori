static inline uint16_t ibv_flow_label_to_udp_sport(uint32_t fl)
{
 uint32_t fl_low = fl & 0x03FFF, fl_high = fl & 0xFC000;

 fl_low ^= fl_high >> 14;
 return (uint16_t)(fl_low | (0xC000));
}




