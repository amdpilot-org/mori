template<typename EqualityOp, int Ret = 0>
struct guarded_inequality_wrapper
{

    EqualityOp op;


    size_t guard;


    __attribute__((host)) __attribute__((device)) inline guarded_inequality_wrapper(EqualityOp op, size_t guard)
        : op(op), guard(guard)
    {}
# 341 "/opt/rocm/include/rocprim/type_traits_functions.hpp" 3
    template<typename T>
    __attribute__((host)) __attribute__((device))
    inline bool
        operator()(const T& a, const T& b, size_t idx) const
    {

        return (idx < guard) ? !op(a, b) : Ret;
    }
};

