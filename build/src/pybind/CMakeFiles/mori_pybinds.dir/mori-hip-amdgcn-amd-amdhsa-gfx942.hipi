namespace msgpack {

namespace v1 {

namespace type {

template <typename T>
inline typename std::enable_if<
    has_as<T>::value
>::type
convert_helper(msgpack::object const& o, T& t) {
    t = o.as<T>();
}
template <typename T>
inline typename std::enable_if<
    !has_as<T>::value
>::type
convert_helper(msgpack::object const& o, T& t) {
    o.convert(t);
}

}


}

}
