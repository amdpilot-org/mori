    (static_cast <bool> (0 && "dest addr not in symmetric heap") ? void (0) : __assert_fail ("false && \"dest addr not in symmetric heap\"", "/sgl-workspace/mori/include/mori/shmem/shmem_device_api.hpp", 129, __extension__ __PRETTY_FUNCTION__));
    return 0;
  }

  size_t offset = localAddrInt - globalGpuStates->heapBaseAddr;

  application::SymmMemObj* heapObj = globalGpuStates->heapObj;
  uint64_t raddr = heapObj->peerPtrs[destPe] + offset;

  return raddr;
}
