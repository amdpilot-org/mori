namespace rocprim { inline namespace ROCPRIM_400200_NS {






template<class T>
class double_buffer
{
    T * buffers[2];

    unsigned int selector;

public:



    __attribute__((host)) __attribute__((device)) inline
    double_buffer()
    {
        selector = 0;
        buffers[0] = nullptr;
        buffers[1] = nullptr;
    }





    __attribute__((host)) __attribute__((device)) inline
    double_buffer(T * current, T * alternate)
    {
        selector = 0;
        buffers[0] = current;
        buffers[1] = alternate;
    }


    __attribute__((host)) __attribute__((device)) inline
    T * current() const
    {
        return buffers[selector];
    }


    __attribute__((host)) __attribute__((device)) inline
    T * alternate() const
    {
        return buffers[selector ^ 1];
    }


    __attribute__((host)) __attribute__((device)) inline
    void swap()
    {
        selector ^= 1;
    }
};

} }
