template <typename T>
inline __attribute__((device)) T ShmemTypeWaitUntilGreaterThan(T* addr, T val) {
  T got;
  do {
    got = core::AtomicLoadRelaxedSystem(addr);
  } while (got <= val);
  return got;
}






inline __attribute__((device)) uint8_t ShmemUint8WaitUntilGreaterThan(uint8_t* addr, uint8_t val) { return ShmemTypeWaitUntilGreaterThan<uint8_t>(addr, val); }
inline __attribute__((device)) int8_t ShmemInt8WaitUntilGreaterThan(int8_t* addr, int8_t val) { return ShmemTypeWaitUntilGreaterThan<int8_t>(addr, val); }
inline __attribute__((device)) signed char ShmemScharWaitUntilGreaterThan(signed char* addr, signed char val) { return ShmemTypeWaitUntilGreaterThan<signed char>(addr, val); }
