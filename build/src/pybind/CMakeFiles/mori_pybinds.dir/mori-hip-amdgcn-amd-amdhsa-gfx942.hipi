all_type_info_get_cache(PyTypeObject *type) {
    auto res = with_internals([type](internals &internals) {
        auto ins = internals
                       .registered_types_py

                       .try_emplace(type);



        if (ins.second) {



            all_type_info_populate(type, ins.first->second);
