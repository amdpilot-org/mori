      u.fp6.val31 = from_float<float_base_t, out_encode, 1>(in[30], scale);
      u.fp6.val32 = from_float<float_base_t, out_encode, 1>(in[31], scale);
    }
    return u.o;
  } else {
    OutType ret;
    u.o = in;
    ret[0] = to_float<float_base_t, in_encode, 1>(u.fp6.val1, scale);
    ret[1] = to_float<float_base_t, in_encode, 1>(u.fp6.val2, scale);
    ret[2] = to_float<float_base_t, in_encode, 1>(u.fp6.val3, scale);
    ret[3] = to_float<float_base_t, in_encode, 1>(u.fp6.val4, scale);
