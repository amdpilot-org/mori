__attribute__((device)) inline __attribute__((always_inline)) unsigned int get_active_lane_num() {
  return get_active_lane_num(get_active_lane_mask());
}

__attribute__((device)) inline __attribute__((always_inline)) int get_first_active_lane_id(uint64_t active_lane_mask) {
  return __ffsll((unsigned long long int)active_lane_mask) - 1;
