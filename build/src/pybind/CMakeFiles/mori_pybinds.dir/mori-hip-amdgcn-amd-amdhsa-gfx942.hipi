inline __attribute__((device)) int DeviceWarpSize() { return 64; }

inline __attribute__((device)) int FlatBlockSize() { return blockDim.z * blockDim.y * blockDim.x; }

inline __attribute__((device)) int FlatBlockThreadId() {
  return (threadIdx.z * blockDim.y * blockDim.x) + (threadIdx.y * blockDim.x) + threadIdx.x;
}

inline __attribute__((device)) int FlatThreadId() {
  return FlatBlockThreadId() +
         (blockIdx.x + blockIdx.y * gridDim.x + blockIdx.z * gridDim.x * gridDim.y) *
             FlatBlockSize();
}

inline __attribute__((device)) int FlatBlockWarpNum() { return FlatBlockSize() / DeviceWarpSize(); }

inline __attribute__((device)) int FlatBlockWarpId() { return FlatBlockThreadId() / DeviceWarpSize(); }

inline __attribute__((device)) int WarpLaneId() { return FlatBlockThreadId() & (DeviceWarpSize() - 1); }

inline __attribute__((device)) int WarpLaneId1D() { return threadIdx.x & (64 - 1); }

inline __attribute__((device)) bool IsThreadZeroInBlock() {
  return (FlatBlockThreadId() % DeviceWarpSize()) == 0;
}

inline __attribute__((device)) uint64_t GetActiveLaneMask() { return __ballot(true); }

inline __attribute__((device)) unsigned int GetActiveLaneCount(uint64_t activeLaneMask) {
  return __popcll(activeLaneMask);
}

inline __attribute__((device)) unsigned int GetActiveLaneCount() {
  return GetActiveLaneCount(GetActiveLaneMask());
}

inline __attribute__((device)) unsigned int GetActiveLaneNum(uint64_t activeLaneMask) {
  return __popcll(activeLaneMask & __lanemask_lt());
}

inline __attribute__((device)) unsigned int GetActiveLaneNum() { return GetActiveLaneNum(GetActiveLaneMask()); }

inline __attribute__((device)) int GetFirstActiveLaneID(uint64_t activeLaneMask) {
  return activeLaneMask ? __ffsll((unsigned long long int)activeLaneMask) - 1 : -1;
}

inline __attribute__((device)) int GetFirstActiveLaneID() { return GetFirstActiveLaneID(GetActiveLaneMask()); }

inline __attribute__((device)) int GetLastActiveLaneID(uint64_t activeLaneMask) {
  return activeLaneMask ? 63 - __clzll(activeLaneMask) : -1;
}

inline __attribute__((device)) int GetLastActiveLaneID() { return GetLastActiveLaneID(GetActiveLaneMask()); }

inline __attribute__((device)) bool IsFirstActiveLane(uint64_t activeLaneMask) {
  return GetActiveLaneNum(activeLaneMask) == 0;
}

inline __attribute__((device)) bool IsFirstActiveLane() { return IsFirstActiveLane(GetActiveLaneMask()); }

inline __attribute__((device)) bool IsLastActiveLane(uint64_t activeLaneMask) {
  return GetActiveLaneNum(activeLaneMask) == GetActiveLaneCount(activeLaneMask) - 1;
}

inline __attribute__((device)) bool IsLastActiveLane() { return IsLastActiveLane(GetActiveLaneMask()); }




template <typename T>
inline __attribute__((device)) T AtomicLoadSeqCst(T* ptr) {
  return __hip_atomic_load(ptr, 5, 4);
}

template <typename T>
inline __attribute__((device)) T AtomicLoadSeqCstSystem(T* ptr) {
  return __hip_atomic_load(ptr, 5, 5);
}

template <typename T>
inline __attribute__((device)) T AtomicLoadRelaxed(T* ptr) {
  return __hip_atomic_load(ptr, 0, 4);
}

template <typename T>
inline __attribute__((device)) T AtomicLoadRelaxedSystem(T* ptr) {
  return __hip_atomic_load(ptr, 0, 5);
}

template <typename T>
inline __attribute__((device)) void AtomicStoreRelaxed(T* ptr, T val) {
  return __hip_atomic_store(ptr, val, 0, 4);
}

template <typename T>
inline __attribute__((device)) void AtomicStoreRelaxedSystem(T* ptr, T val) {
  return __hip_atomic_store(ptr, val, 0, 5);
}

template <typename T>
inline __attribute__((device)) void AtomicStoreSeqCst(T* ptr, T val) {
  return __hip_atomic_store(ptr, val, 5, 4);
}

template <typename T>
inline __attribute__((device)) void AtomicStoreSeqCstSystem(T* ptr, T val) {
  return __hip_atomic_store(ptr, val, 5, 5);
}

template <typename T>
inline __attribute__((device)) T AtomicAddSeqCst(T* ptr, T val) {
  return __hip_atomic_fetch_add(ptr, val, 5, 4);
}

template <typename T>
inline __attribute__((device)) T AtomicAddSeqCstSystem(T* ptr, T val) {
  return __hip_atomic_fetch_add(ptr, val, 5, 5);
}

template <typename T>
inline __attribute__((device)) T AtomicAddRelaxed(T* ptr, T val) {
  return __hip_atomic_fetch_add(ptr, val, 0, 4);
}

template <typename T>
inline __attribute__((device)) T AtomicAddRelaxedSystem(T* ptr, T val) {
  return __hip_atomic_fetch_add(ptr, val, 0, 5);
}

template <typename T>
__attribute__((device)) T AtomicCompareExchange(T* address, T* compare, T val) {
  __hip_atomic_compare_exchange_strong(address, compare, val, 0, 0,
                                       4);
  return *compare;
}

template <typename T>
__attribute__((device)) T AtomicCompareExchangeSystem(T* address, T* compare, T val) {
  __hip_atomic_compare_exchange_strong(address, compare, val, 0, 0,
                                       5);
  return *compare;
}




template <typename T>
constexpr inline __attribute__((device)) __attribute__((host)) T CeilDiv(T a, T b) {
  return (a + b - 1) / b;
}

template <typename T>
constexpr inline __attribute__((device)) __attribute__((host)) T IsPowerOf2(T x) {
  return (x > 0) && ((x & (x - 1)) == 0);
}





__attribute__((device)) inline void AcquireLock(uint32_t* lockVar) {
  while (atomicCAS(lockVar, 0, 1) != 0) {
  }
}

__attribute__((device)) inline bool AcquireLockOnce(uint32_t* lockVar) {
  return atomicCAS(lockVar, 0, 1) == 0;
}


__attribute__((device)) inline void ReleaseLock(uint32_t* lockVar) { atomicExch(lockVar, 0); }



__attribute__((device)) inline __attribute__((always_inline)) uint32_t lowerID() {
  return __ffsll(__ballot(1)) - 1;
}

__attribute__((device)) inline __attribute__((always_inline)) int wave_SZ() { return __popcll(__ballot(1)); }




__attribute__((device)) inline __attribute__((always_inline)) bool is_thread_zero_in_block() {
  return threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0;
}





__attribute__((device)) inline __attribute__((always_inline)) bool is_block_zero_in_grid() {
  return blockIdx.x == 0 && blockIdx.y == 0 && blockIdx.z == 0;
}




__attribute__((device)) inline __attribute__((always_inline)) int get_flat_block_size() {
  return blockDim.x * blockDim.y * blockDim.z;
}




__attribute__((device)) inline __attribute__((always_inline)) int get_flat_grid_size() {
  return get_flat_block_size() * gridDim.x * gridDim.y * gridDim.z;
}





__attribute__((device)) inline __attribute__((always_inline)) int get_flat_block_id() {
  return threadIdx.x + threadIdx.y * blockDim.x +
         threadIdx.z * blockDim.x * blockDim.y;
}




__attribute__((device)) inline __attribute__((always_inline)) int get_grid_num_blocks() {
  return gridDim.x * gridDim.y * gridDim.z;
}





__attribute__((device)) inline __attribute__((always_inline)) int get_flat_grid_id() {
  return blockIdx.x + blockIdx.y * gridDim.x +
         blockIdx.z * gridDim.x * gridDim.y;
}




__attribute__((device)) inline __attribute__((always_inline)) int get_flat_id() {
  return get_flat_grid_id() * (blockDim.x * blockDim.y * blockDim.z) + get_flat_block_id();
}




__attribute__((device)) inline __attribute__((always_inline)) bool is_thread_zero_in_wave() {
  return (get_flat_block_id() % 64) == 0;
}

__attribute__((device)) inline __attribute__((always_inline)) uint64_t get_active_lane_mask() {
  return __ballot(true);
}

__attribute__((device)) inline __attribute__((always_inline)) unsigned int get_active_lane_count(uint64_t active_lane_mask) {
  return __popcll(active_lane_mask);
}

__attribute__((device)) inline __attribute__((always_inline)) unsigned int get_active_lane_count() {
  return get_active_lane_count(get_active_lane_mask());
}

__attribute__((device)) inline __attribute__((always_inline)) unsigned int get_active_lane_num(uint64_t active_lane_mask) {
  return __popcll(active_lane_mask & __lanemask_lt());
