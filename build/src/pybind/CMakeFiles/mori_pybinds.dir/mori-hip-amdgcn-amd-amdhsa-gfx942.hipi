inline void
MPI::Cartcomm::Get_topo(int maxdims, int dims[], bool periods[],
          int coords[]) const
{
  int *int_periods = new int [maxdims];
  int i;
  for (i=0; i<maxdims; i++) {
    int_periods[i] = (int)periods[i];
  }
  (void)MPI_Cart_get(mpi_comm, maxdims, dims, int_periods, coords);
  for (i=0; i<maxdims; i++) {
    periods[i] = ((bool)(int_periods[i]));
  }
  delete [] int_periods;
}

