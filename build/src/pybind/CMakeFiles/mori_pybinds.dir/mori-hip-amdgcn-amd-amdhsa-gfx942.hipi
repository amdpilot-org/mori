__attribute__((host)) __attribute__((device)) static float __amd_scale_to_float(const __amd_scale_t scale_exp) {
  constexpr int8_t OCP_SCALE_EXP_NAN = -128;
  const uint32_t SCALE_EXP_BIAS = 127;



  const size_t SCALE_EXP_SHIFT = 23;

  uint32_t s;
  if (scale_exp == OCP_SCALE_EXP_NAN)
    s = 0xff;
  else
    s = ((uint32_t)scale_exp + SCALE_EXP_BIAS) & 0xffu;

  return fcbx::F32(s << SCALE_EXP_SHIFT);
}
