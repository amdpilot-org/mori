    const application::SymmMemObjPtr signalDest, size_t signalDestOffset, uint64_t signalValue,
    core::atomicType signalOp, int pe, int qpId) {
  bool need_turn{1};
  uint64_t turns = __ballot(need_turn);
  while (turns) {
    uint8_t lane = __ffsll((unsigned long long)turns) - 1;
    int pe_turn = __shfl(pe, lane);
    if (pe_turn == pe) {
      do { if constexpr (0 == 1) { ShmemPutMemNbiSignalThreadKernelImpl<core::ProviderType::BNXT, 0>(dest, destOffset, source, sourceOffset, bytes, signalDest, signalDestOffset, signalValue, signalOp, pe, qpId); } else if constexpr (1 == 1) { ShmemPutMemNbiSignalThreadKernelImpl<core::ProviderType::PSD, 0>(dest, destOffset, source, sourceOffset, bytes, signalDest, signalDestOffset, signalValue, signalOp, pe, qpId); } else { ShmemPutMemNbiSignalThreadKernelImpl<core::ProviderType::MLX5, 0>(dest, destOffset, source, sourceOffset, bytes, signalDest, signalDestOffset, signalValue, signalOp, pe, qpId); } } while (0);


      need_turn = 0;
    }
    turns = __ballot(need_turn);
  }
}

template <core::ProviderType PrvdType, bool onlyOneSignal = 1>
inline __attribute__((device)) void ShmemPutMemNbiSignalWarpKernelImpl(
    const application::SymmMemObjPtr dest, size_t destOffset,
    const application::SymmMemObjPtr source, size_t sourceOffset, size_t bytes,
    const application::SymmMemObjPtr signalDest, size_t signalDestOffset, uint64_t signalValue,
    core::atomicType signalOp, int pe, int qpId) {
  int laneId = threadIdx.x & (64 - 1);
  if (laneId == 0) {
    ShmemPutMemNbiSignalThreadKernelImpl<PrvdType, onlyOneSignal>(
        dest, destOffset, source, sourceOffset, bytes, signalDest, signalDestOffset, signalValue,
        signalOp, pe, qpId);
  }
}

