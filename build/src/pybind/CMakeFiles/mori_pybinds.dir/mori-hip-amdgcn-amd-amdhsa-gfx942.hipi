typedef float2 hipFloatComplex;

__attribute__((host)) __attribute__((device)) static inline float hipCrealf(hipFloatComplex z) { return z.x; }

__attribute__((host)) __attribute__((device)) static inline float hipCimagf(hipFloatComplex z) { return z.y; }

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex make_hipFloatComplex(float a, float b) {
  hipFloatComplex z;
  z.x = a;
  z.y = b;
  return z;
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipConjf(hipFloatComplex z) {
  hipFloatComplex ret;
  ret.x = z.x;
  ret.y = -z.y;
  return ret;
}

__attribute__((host)) __attribute__((device)) static inline float hipCsqabsf(hipFloatComplex z) { return z.x * z.x + z.y * z.y; }

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCaddf(hipFloatComplex p, hipFloatComplex q) {
  return make_hipFloatComplex(p.x + q.x, p.y + q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCsubf(hipFloatComplex p, hipFloatComplex q) {
  return make_hipFloatComplex(p.x - q.x, p.y - q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCmulf(hipFloatComplex p, hipFloatComplex q) {
  return make_hipFloatComplex(p.x * q.x - p.y * q.y, p.y * q.x + p.x * q.y);
}

__attribute__((host)) __attribute__((device)) static inline hipFloatComplex hipCdivf(hipFloatComplex p, hipFloatComplex q) {
  float sqabs = hipCsqabsf(q);
  hipFloatComplex ret;
  ret.x = (p.x * q.x + p.y * q.y) / sqabs;
  ret.y = (p.y * q.x - p.x * q.y) / sqabs;
  return ret;
}

__attribute__((host)) __attribute__((device)) static inline float hipCabsf(hipFloatComplex z) { return sqrtf(hipCsqabsf(z)); }


typedef double2 hipDoubleComplex;

__attribute__((host)) __attribute__((device)) static inline double hipCreal(hipDoubleComplex z) { return z.x; }

__attribute__((host)) __attribute__((device)) static inline double hipCimag(hipDoubleComplex z) { return z.y; }

