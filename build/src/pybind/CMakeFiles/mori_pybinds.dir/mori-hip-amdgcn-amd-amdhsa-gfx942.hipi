__attribute__((host)) __attribute__((device)) static float __amd_cvt_fp8_to_float(
    const __amd_fp8_storage_t val, const __amd_fp8_interpretation_t interpret) {







  using namespace fcbx;
  if (interpret == __AMD_OCP_E4M3) {
    return to_float<float, Encoding::E4M3, 1>(static_cast<uint32_t>(val), 0);
  } else {
    return to_float<float, Encoding::E5M2, 1>(static_cast<uint32_t>(val), 0);
  }

}
