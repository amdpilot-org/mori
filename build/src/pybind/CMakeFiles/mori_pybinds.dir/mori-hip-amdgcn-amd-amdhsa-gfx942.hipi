template <>
inline __attribute__((device)) int PollCq<ProviderType::PSD>(WorkQueueHandle& wqHandle,
                                                CompletionQueueHandle& cqHandle, void* cqAddr,
                                                uint32_t cqeNum, uint32_t* consIdx,
                                                uint16_t* wqeCounter) {
  uint32_t greed = 10;
