template <Encoding E, bool sat> __attribute__((host)) __attribute__((device)) static bool isinf(uint32_t val) {
  const auto& enc = encodings[(size_t)E];
  if (!enc.HasInf) return 0;

  if constexpr (E == Encoding::E5M10 || E == Encoding::E8M7) {
    return exponentbits<E, sat>(val) == enc.ExpMask && mantissa<E, sat>(val) == 0;
  }

  return inf<E, sat>(signbit<E, sat>(val)) == val;
}

template <Encoding E, bool sat> __attribute__((host)) __attribute__((device)) static bool iszero(uint32_t val) {
  return zero<E, sat>(signbit<E, sat>(val)) == val;
