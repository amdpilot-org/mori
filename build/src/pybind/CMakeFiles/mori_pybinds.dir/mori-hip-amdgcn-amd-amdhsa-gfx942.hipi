template <>
struct alignas(4) complex<Half> {
  Half real_;
  Half imag_;


  complex() = default;


  __attribute__((host)) __attribute__((device)) explicit inline complex(const Half& real, const Half& imag)
      : real_(real), imag_(imag) {}
  __attribute__((host)) __attribute__((device)) inline complex(const c10::complex<float>& value)
      : real_(value.real()), imag_(value.imag()) {}


  inline __attribute__((host)) __attribute__((device)) operator c10::complex<float>() const {
    return {real_, imag_};
  }

  constexpr __attribute__((host)) __attribute__((device)) Half real() const {
    return real_;
  }
  constexpr __attribute__((host)) __attribute__((device)) Half imag() const {
    return imag_;
  }

  __attribute__((host)) __attribute__((device)) complex<Half>& operator+=(const complex<Half>& other) {
    real_ = static_cast<float>(real_) + static_cast<float>(other.real_);
    imag_ = static_cast<float>(imag_) + static_cast<float>(other.imag_);
    return *this;
  }

  __attribute__((host)) __attribute__((device)) complex<Half>& operator-=(const complex<Half>& other) {
    real_ = static_cast<float>(real_) - static_cast<float>(other.real_);
    imag_ = static_cast<float>(imag_) - static_cast<float>(other.imag_);
    return *this;
  }

  __attribute__((host)) __attribute__((device)) complex<Half>& operator*=(const complex<Half>& other) {
    auto a = static_cast<float>(real_);
    auto b = static_cast<float>(imag_);
    auto c = static_cast<float>(other.real());
    auto d = static_cast<float>(other.imag());
    real_ = a * c - b * d;
    imag_ = a * d + b * c;
    return *this;
  }
};

}

