template <int64_t unbatched_dim, int64_t batched_dim>
inline Tensor _dropoutNd_helper(
    Tensor input,
    double p,
    bool training,
    bool inplace,
    const char* fn_name) {
  if (!(p >= 0. && p <= 1.)) { ::c10::detail::torchCheckFail( __func__, "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include/torch/nn/functional/dropout.h", static_cast<uint32_t>(59), (::c10::detail::torchCheckMsgImpl( "Expected " "p >= 0. && p <= 1." " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "dropout probability has to be between 0 and 1, but got ", p))); };




  auto inp_dim = input.dim();
  auto is_batched = inp_dim == batched_dim;
  if (!is_batched) {
    if (inplace) {
      input = input.unsqueeze_(0);
    } else {
      input = input.unsqueeze(0);
    }
  }

  Tensor result;
  if (inplace) {
    result = torch::feature_dropout_(input, p, training);
  } else {
    result = torch::feature_dropout(input, p, training);
  }

  if (!is_batched) {
    if (inplace) {
      result = result.squeeze_(0);
    } else {
      result = result.squeeze(0);
    }
  }
  return result;
}

