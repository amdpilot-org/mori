__attribute__((device)) inline __attribute__((always_inline)) bool spin_lock_try_acquire_unique(uint32_t *lock) {
  uint32_t lock_val = 0x0;

  __hip_atomic_compare_exchange_strong(lock, &lock_val, 0xabcd,
            2, 2,
            4);

  return lock_val == 0x0;
}





__attribute__((device)) inline __attribute__((always_inline)) void spin_lock_acquire_unique(uint32_t *lock) {
  while (!spin_lock_try_acquire_unique(lock)) {

  }
}




__attribute__((device)) inline __attribute__((always_inline)) void spin_lock_release_unique(uint32_t *lock) {
  __hip_atomic_store(lock, 0x0, 3,
      4);
}




__attribute__((device)) inline __attribute__((always_inline)) bool spin_lock_try_acquire_shared(uint32_t *lock, uint64_t activemask) {
  uint32_t lock_val = 0xdead;

  if (is_first_active_lane(activemask)) {
 lock_val = 0x0;
 __hip_atomic_compare_exchange_strong(lock, &lock_val, 0xabcd,
           2, 2,
           4);
  }
  lock_val = __shfl(lock_val, get_first_active_lane_id(activemask));

  return lock_val == 0x0;
}




__attribute__((device)) inline __attribute__((always_inline)) void spin_lock_acquire_shared(uint32_t *lock, uint64_t activemask) {
  while (!spin_lock_try_acquire_shared(lock, activemask)) {

  }
}




__attribute__((device)) inline __attribute__((always_inline)) void spin_lock_release_shared(uint32_t *lock, uint64_t activemask) {
  if (is_first_active_lane(activemask)) {
 __hip_atomic_store(lock, 0x0, 3,
        4);
  }
}

