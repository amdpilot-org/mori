namespace msgpack {


namespace v1 {




namespace detail {

template<bool...values> struct all_of_imp
    : std::is_same<bool_pack<values..., 1>, bool_pack<1, values...>>{};

template<bool...values> struct any_of_imp {
    static const bool value = !std::is_same<bool_pack<values..., 0>, bool_pack<0, values...>>::value;
};

}

template<std::size_t... Is> struct seq {};

template<std::size_t N, std::size_t... Is>
struct gen_seq : gen_seq<N-1, N-1, Is...> {};

template<std::size_t... Is>
struct gen_seq<0, Is...> : seq<Is...> {};


}


