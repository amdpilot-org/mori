namespace torch::data {


struct DataLoaderOptions {
  DataLoaderOptions() = default;
                 DataLoaderOptions(size_t batch_size)
      : batch_size_(batch_size) {}


  public: inline auto batch_size(const size_t& new_batch_size) -> decltype(*this) { this->batch_size_ = new_batch_size; return *this; } inline auto batch_size(size_t&& new_batch_size) -> decltype(*this) { this->batch_size_ = std::move(new_batch_size); return *this; } inline const size_t& batch_size() const noexcept { return this->batch_size_; } inline size_t& batch_size() noexcept { return this->batch_size_; } private: size_t batch_size_ = 1;



  public: inline auto workers(const size_t& new_workers) -> decltype(*this) { this->workers_ = new_workers; return *this; } inline auto workers(size_t&& new_workers) -> decltype(*this) { this->workers_ = std::move(new_workers); return *this; } inline const size_t& workers() const noexcept { return this->workers_; } inline size_t& workers() noexcept { return this->workers_; } private: size_t workers_ = 0;



  public: inline auto max_jobs(const std::optional<size_t>& new_max_jobs) -> decltype(*this) { this->max_jobs_ = new_max_jobs; return *this; } inline auto max_jobs(std::optional<size_t>&& new_max_jobs) -> decltype(*this) { this->max_jobs_ = std::move(new_max_jobs); return *this; } inline const std::optional<size_t>& max_jobs() const noexcept { return this->max_jobs_; } inline std::optional<size_t>& max_jobs() noexcept { return this->max_jobs_; } private: std::optional<size_t> max_jobs_;


  public: inline auto timeout(const std::optional<std::chrono::milliseconds>& new_timeout) -> decltype(*this) { this->timeout_ = new_timeout; return *this; } inline auto timeout(std::optional<std::chrono::milliseconds>&& new_timeout) -> decltype(*this) { this->timeout_ = std::move(new_timeout); return *this; } inline const std::optional<std::chrono::milliseconds>& timeout() const noexcept { return this->timeout_; } inline std::optional<std::chrono::milliseconds>& timeout() noexcept { return this->timeout_; } private: std::optional<std::chrono::milliseconds> timeout_;




  public: inline auto enforce_ordering(const bool& new_enforce_ordering) -> decltype(*this) { this->enforce_ordering_ = new_enforce_ordering; return *this; } inline auto enforce_ordering(bool&& new_enforce_ordering) -> decltype(*this) { this->enforce_ordering_ = std::move(new_enforce_ordering); return *this; } inline const bool& enforce_ordering() const noexcept { return this->enforce_ordering_; } inline bool& enforce_ordering() noexcept { return this->enforce_ordering_; } private: bool enforce_ordering_ = true;



  public: inline auto drop_last(const bool& new_drop_last) -> decltype(*this) { this->drop_last_ = new_drop_last; return *this; } inline auto drop_last(bool&& new_drop_last) -> decltype(*this) { this->drop_last_ = std::move(new_drop_last); return *this; } inline const bool& drop_last() const noexcept { return this->drop_last_; } inline bool& drop_last() noexcept { return this->drop_last_; } private: bool drop_last_ = false;
};







struct FullDataLoaderOptions {
  explicit FullDataLoaderOptions(DataLoaderOptions options)
      : batch_size(options.batch_size()),
        workers(options.workers()),
        max_jobs(options.max_jobs().value_or(2 * workers)),
        timeout(options.timeout()),
        enforce_ordering(options.enforce_ordering()),
        drop_last(options.drop_last()) {}

  size_t batch_size;
  size_t workers;
  size_t max_jobs;
  std::optional<std::chrono::milliseconds> timeout;
  bool enforce_ordering;
  bool drop_last;
};
}
