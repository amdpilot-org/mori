  uint64_t turns = __ballot(need_turn);
  while (turns) {
    uint8_t lane = __ffsll((unsigned long long)turns) - 1;
    int pe_turn = __shfl(pe, lane);
    if (pe_turn == pe) {
      do { if constexpr (0 == 1) { ShmemPutMemNbiThreadKernelAddrImpl<core::ProviderType::BNXT>(dest, source, bytes, pe, qpId); } else if constexpr (1 == 1) { ShmemPutMemNbiThreadKernelAddrImpl<core::ProviderType::PSD>(dest, source, bytes, pe, qpId); } else { ShmemPutMemNbiThreadKernelAddrImpl<core::ProviderType::MLX5>(dest, source, bytes, pe, qpId); } } while (0);

      need_turn = 0;
    }
    turns = __ballot(need_turn);
  }
