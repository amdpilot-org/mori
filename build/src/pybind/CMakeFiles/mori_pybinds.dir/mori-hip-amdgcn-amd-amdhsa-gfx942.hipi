  bool valid;

  __attribute__((device)) RemoteAddrInfo() : raddr(0), rkey(0), valid(0) {}
  __attribute__((device)) RemoteAddrInfo(uintptr_t r, uintptr_t k) : raddr(r), rkey(k), valid(1) {}
};

class ShmemStatesSingleton {
 public:
  ShmemStatesSingleton(const ShmemStatesSingleton& obj) = delete;

