template <>
inline __attribute__((device)) void RingDoorbell<ProviderType::BNXT>(void* dbrAddr, uint64_t dbrVal) {
  core::AtomicStoreSeqCstSystem(reinterpret_cast<uint64_t*>(dbrAddr), dbrVal);

}

template <>
inline __attribute__((device)) void UpdateDbrAndRingDbSend<ProviderType::BNXT>(void* dbrRecAddr, uint32_t wqeIdx,
                                                                  void* dbrAddr, uint64_t dbrVal,
                                                                  uint32_t* lockVar) {
  AcquireLock(lockVar);

  UpdateSendDbrRecord<ProviderType::BNXT>(dbrRecAddr, wqeIdx);
  __threadfence_system();
  RingDoorbell<ProviderType::BNXT>(dbrAddr, dbrVal);

  ReleaseLock(lockVar);
}

template <>
