    key_type key;

    value_type value;

    __attribute__((host)) __attribute__((device)) inline key_value_pair() = default;

    __attribute__((host)) __attribute__((device)) inline ~key_value_pair() = default;


    __attribute__((host)) __attribute__((device)) inline key_value_pair(const key_type key, const value_type value)
        : key(key), value(value)
