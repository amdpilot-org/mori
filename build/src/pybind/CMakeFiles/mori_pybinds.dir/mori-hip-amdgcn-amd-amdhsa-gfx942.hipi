      if (!(total_dims < std::numeric_limits<uint16_t>::max())) { ::c10::detail::torchCheckFail( __func__, "/opt/venv/lib/python3.10/site-packages/torch/include/torch/csrc/jit/runtime/argument_spec.h", static_cast<uint32_t>(287), (::c10::detail::torchCheckMsgImpl( "Expected " "total_dims < std::numeric_limits<uint16_t>::max()" " to be true, but got false.  " "(Could this error message be improved?  If so, " "please report an enhancement request to PyTorch.)", "The number of dims cannot be packed into CompleteArgumentSpec:", total_dims))); };



      pod.total_dims = total_dims;
    }


    hash_code = c10::hash_combine(0, ninputs);
    for (auto d : data) {
      hash_code = c10::hash_combine(hash_code, d);
    }
  }



  bool operator==(const CompleteArgumentSpec& spec) const {
    return ninputs == spec.ninputs && data == spec.data;
