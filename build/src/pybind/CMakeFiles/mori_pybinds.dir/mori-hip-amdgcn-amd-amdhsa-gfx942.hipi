      u.fp6.val18 = from_float<float_base_t, out_encode, 1>(in[17], scale);
      u.fp6.val19 = from_float<float_base_t, out_encode, 1>(in[18], scale);
      u.fp6.val20 = from_float<float_base_t, out_encode, 1>(in[19], scale);
      u.fp6.val21 = from_float<float_base_t, out_encode, 1>(in[20], scale);
      u.fp6.val22 = from_float<float_base_t, out_encode, 1>(in[21], scale);
