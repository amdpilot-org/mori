  uint32_t epoch = (flags & BNXT_RE_FLAG_EPOCH_TAIL_MASK) << BNXT_RE_DB_EPOCH_TAIL_SHIFT;

  return bnxt_re_init_db_hdr(((((wqeIdx + 1) & (wqeNum - 1)) * 3) | epoch),
