   }

   __attribute__((device)) inline __attribute__((always_inline)) uint64_t ReserveQueueSpace(const size_t size_in_bytes)
   {
      const uint32_t queue_size_in_bytes = SDMA_QUEUE_SIZE;

      uint64_t cur_index;
      int retries = 0;

      while (1)
      {
         cur_index = __hip_atomic_load(cachedWptr, 0, 4);
         uint64_t new_index = cur_index + size_in_bytes;


