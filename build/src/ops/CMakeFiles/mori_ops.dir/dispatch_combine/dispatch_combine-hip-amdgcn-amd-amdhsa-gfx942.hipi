template <Encoding E, bool sat> __attribute__((host)) __attribute__((device)) static uint32_t exponentbits(uint32_t val) {
  const auto& enc = encodings[(size_t)E];
  return (val >> enc.ManBits) & enc.ExpMask;
}

template <Encoding E, bool sat> __attribute__((host)) __attribute__((device)) static uint32_t mantissa(uint32_t val) {
  const auto& enc = encodings[(size_t)E];
  return val & enc.ManMask;
