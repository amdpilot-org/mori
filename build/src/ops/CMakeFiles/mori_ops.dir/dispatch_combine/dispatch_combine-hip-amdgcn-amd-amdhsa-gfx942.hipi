      do { if constexpr (0 == 1) { ShmemPutMemNbiSignalThreadKernelAddrImpl<core::ProviderType::BNXT, 0>(dest, source, bytes, signalDest, signalValue, signalOp, pe, qpId); } else if constexpr (1 == 1) { ShmemPutMemNbiSignalThreadKernelAddrImpl<core::ProviderType::PSD, 0>(dest, source, bytes, signalDest, signalValue, signalOp, pe, qpId); } else { ShmemPutMemNbiSignalThreadKernelAddrImpl<core::ProviderType::MLX5, 0>(dest, source, bytes, signalDest, signalValue, signalOp, pe, qpId); } } while (0);


      need_turn = 0;
    }
    turns = __ballot(need_turn);
  }
}

template <core::ProviderType PrvdType, bool onlyOneSignal = 1>
inline __attribute__((device)) void ShmemPutMemNbiSignalWarpKernelAddrImpl(const void* dest, const void* source,
                                                              size_t bytes, const void* signalDest,
                                                              uint64_t signalValue,
                                                              core::atomicType signalOp, int pe,
                                                              int qpId) {
