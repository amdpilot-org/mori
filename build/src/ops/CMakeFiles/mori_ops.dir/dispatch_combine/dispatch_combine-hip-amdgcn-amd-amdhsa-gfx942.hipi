};



template <typename T>
__attribute__((device)) inline void GridBarrier(T* barrierPtr) {
  __syncthreads();
  if (threadIdx.x == 0) {
    __threadfence();
    __hip_atomic_fetch_add(barrierPtr, static_cast<T>(1), 0, 4);
  }
  __syncthreads();
  if (threadIdx.x == 0) {
    while (atomicCAS(barrierPtr, static_cast<T>(gridDim.x), static_cast<T>(0)) != 0) {
      __builtin_amdgcn_s_sleep(1);
    }
  }
  __syncthreads();
}


template <bool IsStandalone>
__attribute__((device)) inline void ConvertDispatchOutputDevice(ConvertDispatchOutputArgs args);

template <typename T, bool UseP2PRead>
