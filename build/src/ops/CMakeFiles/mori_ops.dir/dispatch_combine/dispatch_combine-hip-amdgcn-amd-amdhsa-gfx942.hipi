  int shmemNumQpPerPe = ShmemNumQpPerPe();
  if (config.numQpPerPe > shmemNumQpPerPe) {
    config.numQpPerPe = shmemNumQpPerPe;
    mori::ModuleLogger::GetInstance().GetLogger(mori::modules::OPS)->info("numQpPerPe %d larger than shmem numQpPerPe %d, set to %d", config.numQpPerPe, shmemNumQpPerPe, shmemNumQpPerPe);

