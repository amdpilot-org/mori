            ? __builtin_amdgcn_cvt_pk_fp8_f32(val.fval, val.fval, ival, false)
            : __builtin_amdgcn_cvt_pk_bf8_f32(val.fval, val.fval, ival, false);
    val.i32val = ival;
    i8data = val.i8val[0];
  }
  return i8data;
}

