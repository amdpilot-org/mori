}

template <typename T> __attribute__((host)) __attribute__((device)) static T makezero(Encoding E, uint32_t sign) {
  switch (E) {
    case Encoding::E5M10:
      return (T)zero<Encoding::E5M10, 0>(sign);
    case Encoding::E8M7:
