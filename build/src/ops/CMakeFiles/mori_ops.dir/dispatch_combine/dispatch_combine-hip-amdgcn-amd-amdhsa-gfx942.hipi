  uint32_t wqe_type = BNXT_RE_HDR_WT_MASK & BNXT_RE_WR_OPCD_RECV;
  hdr.rsv_ws_fl_wt =
      (wqe_size << BNXT_RE_HDR_WS_SHIFT) | (hdr_flags << BNXT_RE_HDR_FLAGS_SHIFT) | wqe_type;
  hdr.wrid = slotIdx / slotsNum;

  sge.pa = (uint64_t)laddr;
