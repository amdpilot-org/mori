__attribute__((host)) __attribute__((device)) static inline bool hip_fp8_ocp_is_nan(__hip_fp8_storage_t a,
                                                   const __hip_fp8_interpretation_t type) {
  return (type == __HIP_E4M3) ? ((a & 0x7f) == 0x7f)
