      ShmemMallocAndReturnMemObjPtr(maxStagingTokSize, 0x3);
  shmemDispatchOutTokMemObj = ShmemMallocAndReturnMemObjPtr(maxTokenSize, 0x3);
  shmemCombineOutTokMemObj = ShmemMallocAndReturnMemObjPtr(maxTokenSize, 0x3);
  shmemStagingTokMemObj = ShmemMallocAndReturnMemObjPtr(maxStagingTokSize, 0x3);

  size_t maxWeightSize = config.MaxNumTokensToRecv() * config.numExpertPerToken * sizeof(float);
  shmemInpWeightsMemObj = ShmemMallocAndReturnMemObjPtr(maxWeightSize, 0x3);
